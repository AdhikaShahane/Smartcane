[Unit]
Description=SmartCane Robotic Assistive AI Service
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartcane
ExecStart=/usr/bin/python3 /home/pi/smartcane/smartcane_service.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
